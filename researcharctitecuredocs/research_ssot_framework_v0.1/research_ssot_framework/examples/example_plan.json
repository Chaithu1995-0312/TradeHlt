{
  "schema_version": "1.1",
  "intent_id": "crt_expiry_diagnosis",
  "intent": {
    "description": "Explain why CRT states expire, distinguishing clock/session resets from geometry and confirmation failures.",
    "required_claims": {
      "state_producer_identity": [
        "resolve_run_identity.run_identity_record"
      ],
      "expiry_reason_counts": [
        "measure_expiry_reasons.expiry_reason_measurement"
      ],
      "population_identity": [
        "measure_expiry_reasons.population_counts"
      ],
      "measurement_contract": [
        "measure_expiry_reasons.expiry_reason_measurement",
        "measure_state_persistence.state_persistence_measurement"
      ]
    },
    "root_nodes": [
      "assemble_crt_expiry_report"
    ]
  },
  "execution_policy": "NO_ARBITRARY_SCRIPT_EXECUTION",
  "ordered_nodes": [
    {
      "node_id": "resolve_run_identity",
      "purpose": "Pin dataset, code, configuration, schema, timeframe, and state producer before analysis.",
      "operation": "contract_check",
      "inputs": [
        "dataset_identity",
        "code_identity",
        "config_identity",
        "schema_identity",
        "state_producer_id"
      ],
      "outputs": [
        "run_identity_record"
      ],
      "depends_on": [],
      "reuse_policy": "REUSE_ONLY_EXACT_IDENTITY",
      "required": true,
      "state_producer": "none",
      "status": "PLANNED",
      "blocked_reasons": []
    },
    {
      "node_id": "load_crt_transition_trace",
      "purpose": "Locate or generate the canonical CRT transition trace for the pinned run.",
      "operation": "artifact_resolve",
      "inputs": [
        "resolve_run_identity.run_identity_record",
        "transition_trace_contract"
      ],
      "outputs": [
        "crt_transition_trace"
      ],
      "depends_on": [
        "resolve_run_identity"
      ],
      "reuse_policy": "REUSE_IF_CONTRACT_AND_HASH_MATCH",
      "required": true,
      "state_producer": {
        "kind": "crt_engine",
        "config_ref": "config_identity"
      },
      "status": "BLOCKED",
      "blocked_reasons": [
        "External input unresolved: transition_trace_contract"
      ]
    },
    {
      "node_id": "measure_expiry_reasons",
      "purpose": "Count expiry causes by state, reason, and eligible population without pooling distinct state producers.",
      "operation": "measurement",
      "inputs": [
        "load_crt_transition_trace.crt_transition_trace",
        "expiry_reason_contract"
      ],
      "outputs": [
        "expiry_reason_measurement",
        "population_counts"
      ],
      "depends_on": [
        "load_crt_transition_trace"
      ],
      "reuse_policy": "REUSE_IF_CONTRACT_AND_HASH_MATCH",
      "required": true,
      "status": "BLOCKED_UPSTREAM",
      "blocked_reasons": [
        "Upstream dependency not available: load_crt_transition_trace (BLOCKED)"
      ]
    },
    {
      "node_id": "measure_state_persistence",
      "purpose": "Measure state duration and transition survival under a declared censoring rule.",
      "operation": "measurement",
      "inputs": [
        "load_crt_transition_trace.crt_transition_trace",
        "persistence_contract"
      ],
      "outputs": [
        "state_persistence_measurement"
      ],
      "depends_on": [
        "load_crt_transition_trace"
      ],
      "reuse_policy": "REUSE_IF_CONTRACT_AND_HASH_MATCH",
      "required": true,
      "status": "BLOCKED_UPSTREAM",
      "blocked_reasons": [
        "Upstream dependency not available: load_crt_transition_trace (BLOCKED)"
      ]
    },
    {
      "node_id": "assemble_crt_expiry_report",
      "purpose": "Assemble validated measurements, provenance, disagreements, and unresolved gaps into one output.",
      "operation": "evidence_assembly",
      "inputs": [
        "resolve_run_identity.run_identity_record",
        "measure_expiry_reasons.expiry_reason_measurement",
        "measure_expiry_reasons.population_counts",
        "measure_state_persistence.state_persistence_measurement"
      ],
      "outputs": [
        "final_report.md",
        "run_record.json"
      ],
      "depends_on": [
        "resolve_run_identity",
        "measure_expiry_reasons",
        "measure_state_persistence"
      ],
      "reuse_policy": "NEVER_REUSE_FINAL_REPORT_WITHOUT_REVALIDATION",
      "required": true,
      "status": "BLOCKED_UPSTREAM",
      "blocked_reasons": [
        "Upstream dependency not available: measure_expiry_reasons (BLOCKED_UPSTREAM)",
        "Upstream dependency not available: measure_state_persistence (BLOCKED_UPSTREAM)"
      ]
    }
  ],
