digraph flow_training {
    rankdir=LR;
    node [shape=box, fontsize=10];

    subgraph "cluster_training" {
        label="training — Training / Model Pipeline"; style="rounded";
        "config_layer.rr.rr_dataset_builder";
        "core.model_registry";
        "features.dataset_builder";
        "features.dataset_validator";
        "training.evaluator";
        "training.phase5_calibration";
        "training.train_pipeline";
        "training.trainer";
    }

    // 1-hop dependency boundary (not flow members)
    "bitnet.zone_cosine_searcher" [style="dashed", fontcolor="#888888"];
    "config_layer.production_config" [style="dashed", fontcolor="#888888"];
    "engines.live_engine" [style="dashed", fontcolor="#888888"];
    "engines.ml_gaussian_engine" [style="dashed", fontcolor="#888888"];
    "engines.tradenet_meta_engine" [style="dashed", fontcolor="#888888"];
    "features.feature_builder" [style="dashed", fontcolor="#888888"];
    "features.feature_pipeline" [style="dashed", fontcolor="#888888"];
    "features.feature_schema" [style="dashed", fontcolor="#888888"];
    "features.schema_validator" [style="dashed", fontcolor="#888888"];
    "runtime.backtest_v2" [style="dashed", fontcolor="#888888"];
    "runtime.baseline_capture" [style="dashed", fontcolor="#888888"];
    "training.trade_net_v2" [style="dashed", fontcolor="#888888"];
    "utils.integrity_events" [style="dashed", fontcolor="#888888"];

    // member -> member (intra-flow dependencies)
    "core.model_registry" -> "training.evaluator";
    "training.evaluator" -> "features.dataset_builder";
    "training.phase5_calibration" -> "training.evaluator";
    "training.phase5_calibration" -> "training.trainer";
    "training.train_pipeline" -> "config_layer.rr.rr_dataset_builder";
    "training.train_pipeline" -> "core.model_registry";
    "training.train_pipeline" -> "features.dataset_builder";
    "training.train_pipeline" -> "features.dataset_validator";
    "training.train_pipeline" -> "training.evaluator";
    "training.train_pipeline" -> "training.phase5_calibration";
    "training.train_pipeline" -> "training.trainer";
    "training.trainer" -> "core.model_registry";
    "training.trainer" -> "features.dataset_builder";

    // boundary dependencies (one endpoint outside the flow)
    "bitnet.zone_cosine_searcher" -> "features.dataset_builder";
    "config_layer.rr.rr_dataset_builder" -> "features.feature_pipeline";
    "config_layer.rr.rr_dataset_builder" -> "features.feature_schema";
    "config_layer.rr.rr_dataset_builder" -> "features.schema_validator";
    "core.model_registry" -> "config_layer.production_config";
    "core.model_registry" -> "features.feature_pipeline";
    "core.model_registry" -> "features.feature_schema";
    "core.model_registry" -> "utils.integrity_events";
    "engines.live_engine" -> "features.dataset_builder";
    "engines.ml_gaussian_engine" -> "core.model_registry";
    "engines.ml_gaussian_engine" -> "features.dataset_builder";
    "engines.ml_gaussian_engine" -> "training.trainer";
    "engines.tradenet_meta_engine" -> "core.model_registry";
    "engines.tradenet_meta_engine" -> "features.dataset_builder";
    "engines.tradenet_meta_engine" -> "training.trainer";
    "features.dataset_builder" -> "features.feature_schema";
    "features.dataset_validator" -> "config_layer.production_config";
    "features.dataset_validator" -> "features.feature_builder";
    "features.dataset_validator" -> "features.feature_schema";
    "features.feature_builder" -> "features.dataset_builder";
    "runtime.backtest_v2" -> "core.model_registry";
    "runtime.baseline_capture" -> "core.model_registry";
    "training.phase5_calibration" -> "config_layer.production_config";
    "training.trade_net_v2" -> "core.model_registry";
    "training.trade_net_v2" -> "features.dataset_builder";
    "training.trade_net_v2" -> "training.trainer";
    "training.train_pipeline" -> "features.feature_schema";
    "training.trainer" -> "features.feature_schema";
    "training.trainer" -> "training.trade_net_v2";
    "training.trainer" -> "utils.integrity_events";
}
