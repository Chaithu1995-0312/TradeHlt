      },
      {
        "index": 27,
        "name": "wick_size",
        "definition_status": "formal",
        "spec": {
          "formula": "high - low",
          "note": "Historical name. It is the full candle range, NOT the shadow length. The name is kept for compatibility; implementations that subtract the body (high - low - body) do not satisfy this contract.",
          "dtype_batch": "float64",
          "missing_value_policy": "inputs must be finite; non-finite inputs are an error for the caller, never zero-filled"
        },
        "implementation_digest": "44c43254c9fc4a66c7e9c70279f723c0c1a13a17fd7863812d6362a0d20b53a5"
      },
      {
        "index": 28,
        "name": "body_ratio",
        "definition_status": "formal",
        "spec": {
          "formula": "body_size / wick_size",
          "zero_range_behavior": "0.0 when wick_size (high - low) <= 0",
          "range": "[0.0, 1.0] for valid candles (low <= open, close <= high)",
          "dtype_batch": "float32",
          "dtype_note": "the batch pipeline casts to float32; consumers compare with relative tolerance 1e-6",
          "missing_value_policy": "inputs must be finite; non-finite inputs are an error for the caller, never zero-filled",
          "authority": "matches FeaturePipeline.compute_canonical_price_features, config_layer.crt_engine_v2.Candle and scripts/backtest/manual_backtest.py; body_ratio_min thresholds (0.65 to 0.70) in the production config were calibrated on this definition."
        },
        "implementation_digest": "44c43254c9fc4a66c7e9c70279f723c0c1a13a17fd7863812d6362a0d20b53a5"
