  "null_semantics": {
    "zone_distance": "{f}_distance is a float and is NEVER null. Exactly 0.0 means NO STRUCTURE EXISTS (the features.smc convention), not zero distance.",
    "zone_geometry": "Every other {f}_* field is null if and only if {f}_present is false. There is no third state, so {f}_present is the single presence authority.",
    "width_atr": "{f}_width_atr is null (not 0.0) when atr_abs <= 0: a zero-ATR width is UNDEFINED, the opposite of the *_distance convention.",
    "parent_block": "All parent/HTF/objective fields are null when parent_crt.enabled is false (ParentCRTFeed.from_prod_config returns None). Null is the honest reading -- not observed -- never 0 and never a default enum member.",
    "warmup_rows": "phase=WARMUP rows carry identity + bar only (23 fields). engine_candle_index, htf_candle_id and atr_abs are null because the engine has no state for that bar.",
    "window_truncated": "{f}_window_truncated is len(window) >= smc_max_window: a window-SATURATION marker, False only for the first ~smc_max_window bars. It is a warmup marker, NOT an exclusion criterion -- use {f}_age_bars against smc_window_len for boundary proximity. Listed in MC-CTXATTR forbidden_metric_substitutions."
  },
  "parquet": {
    "_comment": "The parquet file is a REGENERABLE PROJECTION and never a second authority (CC-PARQUET-PROJECTION). JSONL is the system of record.",
    "writer": "src/utils/parquet_store.py compact_jsonl",
    "verifier": "src/utils/parquet_store.py verify_projection (round-trip; a projection that does not verify is DELETED, not shipped)",
    "family_default": "scripts/maintenance/jsonl_to_parquet.py FAMILY_DEFAULTS '_bar_structure.jsonl' -> ('crt_state_after', None)",
    "partition_by": "crt_state_after",
    "partition_rationale": "The attribution program (SEM-036) reads strictly per-stratum -- its primary metric is an overlay computed INSIDE each CRT state -- so partition pruning matches the access pattern exactly. Warmup rows carry a null state and land in their own __null__ partition, which is the honest placement: they have no engine state rather than a RANGE one.",
    "measured": {
      "jsonl_bytes": 181942241,
      "parquet_bytes_approx": 7759462,
      "compression": "zstd",
      "partitions_observed": [
        "RANGE",
        "SWEEP",
        "DISPLACEMENT",
        "EXPANSION",
        "RETEST",
        "EXECUTION",
        "SHADOW_PENDING",
        "__null__"
      ],
      "verified_rows": 47275
    },
    "nullability": "parquet_store resolves per-column policy from the observed value set; a column that is sometimes absent gains a __present__ presence mask. Ambiguous columns degrade to lossless JSON text rather than guessing a type."
  },
