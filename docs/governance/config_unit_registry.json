    "fraction": "value in [0, 1]; 0.005 == 0.5%. Range [0, 1].",
    "inr": "Indian rupees (deposit currency, portfolio.currency). Must be >= 0.",
    "money_unspecified": "money amount whose currency is not declared at the key or its consumer. Must be >= 0.",
    "rate": "conversion rate (e.g. INR per USD). Must be > 0.",
    "UNVERIFIED": "unit not established from a consumer; excluded from range/agreement checks. Count is a shrink-only ratchet."
  },
