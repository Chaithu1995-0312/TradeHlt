{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradelatest://governance/corpus_authority_decision.schema.json",
  "title": "CorpusAuthorityDecision",
  "description": "Authority decision for one logical OHLCV corpus. UNRESOLVED cannot enter a binding manifest and cannot be loaded by governed research paths once R3 admission exists. Path-convention census authority_class is NOT an authority decision. Synthetic corpora are allowed only with declared derivation lineage + field semantics (G-10: ban undeclared substitution, not synthesis).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision_id",
    "logical_corpus_id",
    "candidate_physical_artifacts",
    "candidate_hashes",
    "source_family",
    "acquisition_path",
    "integrity_gate_level",
    "transformation_chain",
    "timestamp_evidence",
    "volume_semantic",
    "current_consumers",
    "authority_decision",
    "decision_evidence",
    "decision_status",
    "decided_at_utc",
    "decided_by"
  ],
  "properties": {
    "decision_id": {
      "type": "string",
      "pattern": "^CAD-[A-Z0-9][A-Z0-9_-]+$",
      "description": "Stable decision id (e.g. CAD-XAUUSD_M15-SEED)."
    },
    "logical_corpus_id": {
      "type": "string",
      "pattern": "^[A-Z0-9]+_[A-Z0-9]+$",
      "description": "Logical id SYMBOL_TIMEFRAME (e.g. XAUUSD_M15)."
    },
    "candidate_physical_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["physical_path", "sha256"],
        "properties": {
          "candidate_id": { "type": ["string", "null"] },
          "physical_path": { "type": "string" },
          "sha256": { "type": ["string", "null"] },
          "corpus_family_id": { "type": ["string", "null"] },
          "authority_class_census": { "type": ["string", "null"] },
          "rows": { "type": ["integer", "null"] },
          "first_timestamp": { "type": ["string", "null"] },
          "last_timestamp": { "type": ["string", "null"] },
          "duplicate_content_group": { "type": ["string", "null"] },
          "integrity_gate_outcome": { "type": ["string", "null"] },
          "notes": { "type": ["string", "null"] }
        }
      }
    },
    "candidate_hashes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source_family": {
      "type": "string",
      "description": "Dominant or AMBIGUOUS when multiple families claim the logical id."
    },
    "acquisition_path": {
      "type": "string",
      "description": "Fetcher script or UNKNOWN."
    },
    "integrity_gate_level": {
      "type": "string",
      "description": "none | default_L3 | strict_fetch | mixed | unknown"
    },
    "transformation_chain": {
      "type": "array",
      "items": { "type": "string" },
      "description": "T-record ids or provenance edge labels."
    },
    "timestamp_evidence": {
      "type": "object",
      "additionalProperties": true,
      "required": ["status"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["PROVEN", "UNPROVEN", "NARRATIVE", "UNKNOWN"]
        },
        "refs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "volume_semantic": {
      "type": "string",
      "enum": [
        "BASE_ASSET_VOLUME",
        "QUOTE_ASSET_VOLUME",
        "TICK_VOLUME",
        "TICK_VOLUME_APPROXIMATE",
        "LEG_VOLUME",
        "SYNTHETIC_PRICE_RANGE_PROXY",
        "NONE",
        "UNDECLARED"
      ],
      "description": "TICK_VOLUME_APPROXIMATE added for BC-4a schema-wiring parity with dataset_identity.schema.json (F-099: MT5 volume is measured APPROXIMATE, not CONFIRMED). Adding the member is expressibility only -- is_synthetic enforcement and SEED-OHLCV-19 remain open; BC-4 stays a blocker (CORPUS_AUTHORITY.md)."
    },
    "volume_meta": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "properties": {
        "is_synthetic": { "type": "boolean" },
        "unit": { "type": ["string", "null"] },
        "source_field": { "type": ["string", "null"] },
        "transformation_id": { "type": ["string", "null"] }
      }
    },
    "current_consumers": {
      "type": "array",
      "items": { "type": "string" }
    },
    "authority_decision": {
      "type": "string",
      "description": "Human-readable ruling. Must not launder silent replacement without evidence."
    },
    "decision_evidence": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "decision_status": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED",
        "QUARANTINED",
        "UNRESOLVED",
        "FROZEN_CANDIDATE_PENDING_PHASE1_VALIDATION"
      ],
      "description": "UNRESOLVED → no binding. FROZEN_CANDIDATE_PENDING_PHASE1_VALIDATION → Phase-1 validation may target the frozen candidate object only (not AUTHORITATIVE/VALIDATED/ECONOMICALLY_ADMISSIBLE). APPROVED → may enter production binding manifest (R3)."
    },
    "phase1_frozen_candidate": {
      "type": ["object", "null"],
      "additionalProperties": true,
      "description": "When status is FROZEN_CANDIDATE_PENDING_PHASE1_VALIDATION: exact path/hash/range binding. Must NOT set approved_* authority fields.",
      "properties": {
        "binding_ref": { "type": "string" },
        "physical_path": { "type": "string" },
        "content_hash_sha256": { "type": "string" },
        "rows": { "type": "integer" },
        "allowed_time_range": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        }
      }
    },
    "decided_at_utc": {
      "type": "string"
    },
    "decided_by": {
      "type": "string"
    },
    "approved_physical_path": {
      "type": ["string", "null"],
      "description": "Binding pointer. MUST be null when decision_status is UNRESOLVED."
    },
    "approved_sha256": {
      "type": ["string", "null"],
      "description": "Binding hash. MUST be null when decision_status is UNRESOLVED."
    },
    "supersedes": { "type": ["string", "null"] },
    "superseded_by": { "type": ["string", "null"] },
    "authority_ambiguous_census": { "type": ["boolean", "null"] },
    "same_logical_different_bytes": { "type": ["boolean", "null"] },
    "adjudication_package": {
      "type": ["string", "null"],
      "description": "Path to decision package (golden vertical slices)."
    },
    "recommended_options": {
      "type": ["array", "null"],
      "items": { "type": "string" },
      "description": "User-facing option labels pending selection (e.g. A/B/C/D)."
    }
  }
}
