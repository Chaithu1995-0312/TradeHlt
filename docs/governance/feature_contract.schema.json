{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tradelatest://governance/feature_contract.schema.json",
  "title": "FeatureContract",
  "description": "Canonical Feature Truth Layer contract. PROVEN_* statuses require executable evidence. Env flags are not permanent production semantic authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "schema_version",
    "created_utc",
    "production_remediation_started",
    "economic_claims_allowed",
    "corpus_binding",
    "features"
  ],
  "properties": {
    "contract_id": { "type": "string", "const": "FEATURE-CONTRACT-V1" },
    "schema_version": { "type": "string", "const": "1.0.0" },
    "created_utc": { "type": "string" },
    "production_remediation_started": { "type": "boolean", "const": false },
    "economic_claims_allowed": { "type": "boolean", "const": false },
    "legacy_freeze_ref": { "type": "string" },
    "fingerprint_ref": { "type": "string" },
    "corpus_binding": {
      "type": "object",
      "required": ["physical_path", "sha256", "rows", "status"],
      "properties": {
        "physical_path": { "type": "string" },
        "sha256": { "type": "string" },
        "rows": { "type": "integer" },
        "status": { "type": "string" },
        "allowed_time_range": {
          "type": "object",
          "properties": {
            "start": { "type": "string" },
            "end": { "type": "string" }
          }
        }
      }
    },
    "features": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/feature_entry" }
    },
    "vector_members": {
      "type": "array",
      "items": { "type": "string" },
      "description": "feature_ids that participate in the ordered canonical vector (subset of features)."
    },
    "explicit_separations": {
      "type": "array",
      "items": { "type": "object" }
    }
  },
  "$defs": {
    "feature_status": {
      "type": "string",
      "enum": [
        "UNADJUDICATED",
        "PROVEN_CORRECT",
        "PROVEN_PIT_SAFE",
        "PROVEN_DELAYED_SAFE",
        "SEMANTICALLY_DIVERGENT",
        "FORMULA_AUTHORITY_AMBIGUOUS",
        "LEAKING",
        "BLOCKED",
        "DEPRECATED_NAME_ONLY"
      ]
    },
    "feature_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_name",
        "feature_id",
        "formula_id",
        "formula_version",
        "formula_definition",
        "formula_authority",
        "implementation_authority",
        "source_fields",
        "source_field_semantics",
        "intermediate_dependencies",
        "direct_feature_dependencies",
        "transitive_feature_dependencies",
        "lookback",
        "lookahead",
        "warmup",
        "statefulness",
        "value_timestamp",
        "available_at_timestamp",
        "publication_delay",
        "PIT_semantic",
        "batch_semantic",
        "runtime_semantic",
        "missing_value_policy",
        "fallback_policy",
        "synthetic_input_policy",
        "normalization_policy",
        "dtype",
        "bounds",
        "units",
        "output_order",
        "active_consumers",
        "training_consumers",
        "backtest_consumers",
        "live_consumers",
        "model_artifact_requirements",
        "tests",
        "adversarial_probes",
        "status"
      ],
      "properties": {
        "feature_name": { "type": "string" },
        "feature_id": { "type": "string", "pattern": "^FEAT-[A-Z0-9][A-Z0-9_-]*$" },
        "formula_id": { "type": "string" },
        "formula_version": { "type": "string" },
        "formula_definition": { "type": "string" },
        "formula_authority": { "type": "string" },
        "implementation_authority": { "type": "string" },
        "source_fields": { "type": "array", "items": { "type": "string" } },
        "source_field_semantics": { "type": "string" },
        "intermediate_dependencies": { "type": "array", "items": { "type": "string" } },
        "direct_feature_dependencies": { "type": "array", "items": { "type": "string" } },
        "transitive_feature_dependencies": { "type": "array", "items": { "type": "string" } },
        "lookback": { "type": ["integer", "string", "null"] },
        "lookahead": { "type": ["integer", "string", "null"] },
        "warmup": { "type": ["integer", "string", "null"] },
        "statefulness": { "type": "string" },
        "value_timestamp": { "type": "string" },
        "available_at_timestamp": { "type": "string" },
        "publication_delay": { "type": ["integer", "string", "null"] },
        "PIT_semantic": { "type": "string" },
        "batch_semantic": { "type": "string" },
        "runtime_semantic": { "type": "string" },
        "missing_value_policy": { "type": "string" },
        "fallback_policy": { "type": "string" },
        "synthetic_input_policy": { "type": "string" },
        "normalization_policy": { "type": "string" },
        "dtype": { "type": "string" },
        "bounds": { "type": ["string", "null"] },
        "units": { "type": ["string", "null"] },
        "output_order": { "type": ["integer", "null"] },
        "active_consumers": { "type": "array", "items": { "type": "string" } },
        "training_consumers": { "type": "array", "items": { "type": "string" } },
        "backtest_consumers": { "type": "array", "items": { "type": "string" } },
        "live_consumers": { "type": "array", "items": { "type": "string" } },
        "model_artifact_requirements": { "type": "array", "items": { "type": "string" } },
        "tests": { "type": "array", "items": { "type": "string" } },
        "adversarial_probes": { "type": "array", "items": { "type": "string" } },
        "status": { "$ref": "#/$defs/feature_status" },
        "evidence": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" },
        "is_vector_member": { "type": "boolean" },
        "is_synthetic": { "type": "boolean" },
        "planned_canonical_intent": { "type": "string" }
      }
    }
  }
}
