{
  "tune_only": {
    "mode": "pipeline",
    "patterns": ["^tune only", "^just tune", "run tuner", "run auto.?tun", "grid search only"]
  },
  "tune_and_validate": {
    "mode": "pipeline",
    "patterns": ["tune.*and.*valid", "tune.*then.*valid", "run.*tune.*valid"]
  },
  "tune_and_promote": {
    "mode": "pipeline",
    "patterns": ["tune.*promot", "promot.*after.*tun", "tune.*and.*promot", "retrain.*promot", "full.*tun.*promot"]
  },
  "validate_only": {
    "mode": "pipeline",
    "patterns": ["^validate", "just.*valid", "run.*valid", "check.*valid", "valid.*only"]
  },
  "promote_only": {
    "mode": "pipeline",
    "patterns": ["^promote", "just.*promot", "promot.*latest", "promot.*checkpoint", "push.*to.*prod"]
  },
  "backtest_only": {
    "mode": "pipeline",
    "patterns": ["^backtest", "just.*backtest", "run.*backtest", "replay"]
  },
  "full_pipeline": {
    "mode": "pipeline",
    "patterns": ["full.*pipeline", "run.*everything", "end.*to.*end", "tune.*valid.*promot.*backtest"]
  },
  "advise_signal": {
    "mode": "copilot",
    "patterns": ["advise.*signal", "what.*signal", "should.*take", "explain.*signal", "analyse.*signal", "analyze.*signal"]
  },
  "veto_query": {
    "mode": "copilot",
    "patterns": ["veto", "should.*skip", "should.*pass", "why.*buy", "why.*sell", "reject.*signal"]
  },
  "resize_query": {
    "mode": "copilot",
    "patterns": ["resize", "position.*size", "how.*much.*risk", "factor.*position", "adjust.*size"]
  },
  "governance_inspect": {
    "mode": "governance",
    "patterns": ["inspect.*govern", "check.*govern", "review.*govern", "governance.*status", "meta.*dry.*run"]
  },
  "governance_propose": {
    "mode": "governance",
    "patterns": ["propose.*config", "suggest.*tweak", "reflect.*on.*trade", "why.*win.*rate", "config.*change", "patch.*config"]
  },
  "governance_run": {
    "mode": "governance",
    "patterns": ["run.*governance", "meta.*loop", "governance.*loop", "run.*reflect", "run.*gov"]
  },
  "audit_inspect": {
    "mode": null,
    "patterns": ["audit.*log", "show.*audit", "tail.*audit", "recent.*decisions"]
  },
  "findings_synthesize": {
    "mode": null,
    "patterns": ["^synthesi[sz]e .*([a-f0-9]{6,})", "^analy[sz]e (run|finding) ([a-f0-9]{6,})", "diagnose .*([a-f0-9]{6,})"]
  },
  "findings_recent": {
    "mode": null,
    "patterns": ["^(show|list|recent) findings?", "what.*findings", "any.*findings"]
  },
  "findings_explain": {
    "mode": null,
    "patterns": ["^(explain|why) (run|finding) ([a-f0-9]{6,})", "explain.*([a-f0-9]{6,})"]
  },
  "ops_diagnose": {
    "mode": "ops",
    "patterns": [
      "ops[\\s_-]?doctor",
      "ask\\s+grokagenticai.*diagnos",
      "grokagenticai.*diagnos",
      "diagnos(e|is|ing)",
      "why.*(no|zero|few).*trade",
      "throughput",
      "incident\\s*pack",
      "funnel\\s*(fail|diagnos|drop)"
    ]
  },
  "campaign_run": {
    "mode": "pipeline",
    "patterns": [
      "campaign[\\s_-]?runner",
      "ask\\s+grokagenticai.*campaign",
      "grokagenticai.*campaign",
      "run\\s+campaign",
      "tune.*until",
      "campaign\\s+(for|on|until)"
    ]
  },
  "campaign_tune_validate": {
    "mode": "pipeline",
    "patterns": [
      "campaign.*tune.*valid",
      "tune\\s+and\\s+validate\\s+campaign"
    ]
  },
  "truth_janitor": {
    "mode": "truth",
    "patterns": [
      "truth[\\s_-]?janitor",
      "ask\\s+grokagenticai.*hygiene",
      "grokagenticai.*hygiene",
      "ask\\s+grokagenticai.*truth",
      "construction\\s+protocol",
      "doc\\s*drift",
      "citation\\s+sync",
      "script\\s+census",
      "feature[\\s_-]?math\\s+lint",
      "repo\\s+hygiene",
      "governance\\s+hygiene"
    ]
  }
}
